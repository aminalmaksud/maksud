<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- top bar: logo · library pills · settings -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="48dp"
        android:paddingTop="20dp"
        android:paddingEnd="48dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/logoMark"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:importantForAccessibility="no"
            android:src="@drawable/logo" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/bebas_neue"
                    android:text="@string/logo_name"
                    android:textColor="@color/maroon"
                    android:textSize="28sp" />

                <TextView
                    android:id="@+id/logoTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/bebas_neue"
                    android:paddingStart="7dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="7dp"
                    android:text="TV"
                    android:textColor="@color/white"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/hind_siliguri_semibold"
                android:text="@string/logo_bangla"
                android:textColor="@color/faint"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- scrolls sideways if the pills (sections, My List, Now playing, Stop) don't fit -->
        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="16dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/nav"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <ImageButton
            android:id="@+id/settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/round_btn"
            android:contentDescription="@string/settings"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings"
            android:tint="@color/maroon" />
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:textColor="@color/dim"
        android:textSize="16sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="36dp"
        android:paddingTop="8dp"
        android:paddingEnd="36dp"
        android:paddingBottom="40dp" />
</LinearLayout>

<!-- Mini player: Back from the player keeps the video going here. "Now playing" in the top bar brings it back. -->
<LinearLayout
    android:id="@+id/mini"
    android:layout_width="336dp"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|end"
    android:layout_margin="28dp"
    android:elevation="20dp"
    android:orientation="vertical"
    android:padding="3dp"
    android:visibility="gone">

    <androidx.media3.ui.PlayerView
        android:id="@+id/miniPlayer"
        android:layout_width="match_parent"
        android:layout_height="186dp"
        android:focusable="false"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:surface_type="texture_view"
        app:use_controller="false" />

    <TextView
        android:id="@+id/miniTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/bebas_neue"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:singleLine="true"
        android:textColor="@color/white"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/miniHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp"
        android:singleLine="true"
        android:text="▶ Now playing (top bar) to watch · ⏯ pauses"
        android:textColor="@color/gold2"
        android:textSize="12sp" />
</LinearLayout>
</FrameLayout>
