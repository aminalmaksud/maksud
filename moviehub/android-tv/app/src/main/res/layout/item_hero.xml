<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hero"
    android:layout_width="match_parent"
    android:layout_height="300dp"
    android:layout_margin="12dp">

    <ImageView
        android:id="@+id/heroArt"
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="44dp"
        android:paddingEnd="300dp">

        <TextView
            android:id="@+id/eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/hind_siliguri_semibold"
            android:paddingStart="14dp"
            android:paddingTop="4dp"
            android:paddingEnd="14dp"
            android:paddingBottom="4dp"
            android:text="@string/featured"
            android:textColor="@color/gold2"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/heroTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:fontFamily="@font/bebas_neue"
            android:maxLines="2"
            android:textColor="@color/white"
            android:textSize="64sp" />

        <TextView
            android:id="@+id/heroMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gold2"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/heroPlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/btn_primary"
            android:focusable="true"
            android:fontFamily="@font/bebas_neue"
            android:paddingStart="30dp"
            android:paddingTop="10dp"
            android:paddingEnd="30dp"
            android:paddingBottom="8dp"
            android:text="@string/play"
            android:textColor="#3A0D10"
            android:textSize="22sp" />
    </LinearLayout>
</FrameLayout>
