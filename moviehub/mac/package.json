{
  "name": "moviehub",
  "productName": "MusingsofMaksudTV",
  "version": "1.0.0",
  "description": "MusingsofMaksudTV: movies, series and anime from your ISP media servers",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dmg"
  },
  "dependencies": {
    "ffmpeg-static": "5.2.0",
    "ffprobe-static": "3.1.0"
  },
  "devDependencies": {
    "electron": "33.2.0",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.musingsofmaksud.tv",
    "productName": "MusingsofMaksudTV",
    "directories": { "output": "dist" },
    "files": ["main.cjs", "package.json", "node_modules/**/*"],
    "extraResources": [
      { "from": "../web", "to": "web", "filter": ["**/*", "!config.json", "!test.js", "!start.command", "!node_modules/**"] }
    ],
    "asarUnpack": ["node_modules/ffmpeg-static/**", "node_modules/ffprobe-static/**"],
    "afterPack": "build/adhoc-sign.cjs",
    "mac": {
      "category": "public.app-category.entertainment",
      "icon": "build/icon.png",
      "identity": null,
      "target": ["dmg"]
    },
    "dmg": { "title": "MusingsofMaksudTV" },
    "artifactName": "MusingsofMaksudTV-${version}-${arch}.${ext}"
  }
}
