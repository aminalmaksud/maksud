{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StreamHub",
  "version": "1.0.5",
  "identifier": "com.musingsofmaksud.streamhub",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Entertainment",
    "shortDescription": "Movies, series and anime from your ISP media servers",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "externalBin": ["binaries/mmtv-server", "binaries/ffmpeg", "binaries/ffprobe"],
    "resources": { "../../web/public/": "public/" },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
